# Nexora Backend Environment Variables
PORT=5000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_or_service_key

# Gmail SMTP Configuration for Admin Approvals & Verification
GMAIL_USER=your_gmail_address
GMAIL_APP_PASSWORD=your_gmail_app_password

# Cloudinary Configuration for Encrypted Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# WebRTC STUN/TURN Servers (optional override — defaults to Google free STUN)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
